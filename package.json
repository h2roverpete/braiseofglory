{
  "name": "www.braiseofglory.com",
  "version": "1.4.9",
  "private": true,
  "workspaces": [
    "src/framework"
  ],
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.4",
    "react-router": "7.12.0",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.1",
    "sass": "^1.98.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "gulp buildIndex && react-scripts start",
    "build": "gulp buildSitemap && gulp buildIndex && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "aws s3 sync ./build s3://www.braiseofglory.com && gulp createInvalidation",
    "deploy-code": "aws s3 sync ./build s3://www.braiseofglory.com --exclude 'images/*' &&  gulp createInvalidation",
    "add-framework": "git subtree add --prefix=src/framework https://github.com/h2roverpete/framework.git main",
    "push-framework": "git subtree push --prefix=src/framework https://github.com/h2roverpete/framework.git main",
    "pull-framework": "git status && git subtree pull --prefix=src/framework https://github.com/h2roverpete/framework.git main"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "bootstrap": "^5.3.8",
    "colors": "^1.4.0",
    "dotenv": "^17.4.2",
    "gulp": "^5.0.1",
    "minimist": "^1.2.8",
    "react": "^19.2.7",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "sass": "^1.101.0",
    "web-vitals": "^2.1.4"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!axios)/"
    ]
  }
}
